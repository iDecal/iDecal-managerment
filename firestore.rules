rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== SỬA DÒNG NÀY: Gmail của chủ cửa hàng (viết thường, giống ownerEmail trong config.js) ======
    function ownerEmail() { return 'idecals.net@gmail.com'; }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isOwner() { return signedIn() && hasProfile() && myRole() == 'owner'; }
    function isMgr()   { return signedIn() && hasProfile() && myRole() in ['owner', 'manager']; }
    function isStaff() { return signedIn() && hasProfile() && myRole() in ['owner', 'manager', 'staff']; }

    // ---- Hồ sơ thành viên ----
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      // Tự tạo hồ sơ của chính mình: mặc định "chờ duyệt"; chỉ đúng Gmail của chủ mới được là "owner"
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && (request.resource.data.role == 'pending'
            || (request.resource.data.role == 'owner'
                && request.auth.token.email.lower() == ownerEmail()));
      // Chủ đổi cấp cho người khác (chỉ đổi trường role)
      allow update: if isOwner()
        && uid != request.auth.uid
        && resource.data.role != 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['pending', 'staff', 'manager', 'blocked'];
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ---- Khách hàng, đơn hàng, báo giá: nhân viên tạo/sửa; chỉ quản lý trở lên được xoá ----
    match /customers/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isMgr();
    }
    match /orders/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isMgr();
    }
    match /quotes/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isMgr();
    }

    // ---- Sản phẩm: nhân viên chỉ được đổi tồn kho (khi bán hàng) ----
    match /products/{id} {
      allow read: if isStaff();
      allow create, delete: if isMgr();
      allow update: if isMgr()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // ---- Mua hàng, chi phí: chỉ quản lý trở lên ----
    match /purchases/{id} {
      allow read, write: if isMgr();
    }
    match /expenses/{id} {
      allow read, write: if isMgr();
    }

    // Báo giá / file NCC chỉ dành cho chủ và quản lý.
    match /supplierQuotes/{id} {
      allow read, write: if isMgr();
    }

    // Thành viên đã duyệt đọc công việc; chỉ quản lý giao/sửa nội dung.
    match /teamTasks/{id} {
      allow read: if isStaff();
      allow create: if isMgr()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMgr() || (isStaff()
        && resource.data.assignee == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['Cần làm', 'Đang thực hiện', 'Chờ duyệt', 'Hoàn thành']);
      allow delete: if isMgr();
    }
    match /teamMessages/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMgr();
    }

    // ---- Bộ đếm mã đơn (nhân viên được ghi) và thông tin cửa hàng (quản lý được ghi) ----
    match /meta/{doc} {
      allow read: if isStaff();
      allow write: if isMgr() || (isStaff() && doc == 'counters');
    }
  }
}
